    {
      "id": "pdf.tables",
      "title": "Extract tables",
      "description": "Find tables in a PDF and save them as a spreadsheet (one sheet per table) or CSV files. Check the result: table detection is not perfect.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "format": {
          "type": "enum",
          "label": "Save as",
          "options": [
            {
              "value": "xlsx",
              "label": "Excel workbook (XLSX)"
            },
            {
              "value": "csv",
              "label": "CSV files (in a ZIP file)"
            }
          ],
          "default": "xlsx"
        },
        "pages": {
          "type": "text",
          "label": "Pages (empty = all pages)",
          "maxLength": 500,
          "default": "",
          "placeholder": "e.g. 1-3, 5, 8-"
        }
