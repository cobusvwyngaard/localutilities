{
  "schemaVersion": 1,
  "categories": [
    {
      "id": "download",
      "title": "Download"
    },
    {
      "id": "video",
      "title": "Video"
    },
    {
      "id": "audio",
      "title": "Audio"
    },
    {
      "id": "pdf",
      "title": "PDF"
    },
    {
      "id": "image",
      "title": "Images"
    },
    {
      "id": "document",
      "title": "Documents"
    },
    {
      "id": "text",
      "title": "Text"
    }
  ],
  "dependencyIds": [
    "ffmpeg",
    "ffprobe",
    "deno",
    "yt-dlp",
    "pikepdf",
    "ghostscript",
    "tesseract",
    "whisper",
    "libreoffice",
    "pandoc",
    "calibre"
  ],
  "tools": [
    {
      "id": "download.media",
      "title": "Download video or audio",
      "description": "YouTube and other sites supported by yt-dlp. Only download what you have the right to.",
      "category": "download",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "url"
        ],
        "min": 1,
        "max": 1
      },
      "params": {
        "mode": {
          "type": "enum",
          "label": "Download",
          "options": [
            {
              "value": "video",
              "label": "Video (MP4)"
            },
            {
              "value": "audio",
              "label": "Audio only"
            }
          ],
          "default": "video"
        },
        "quality": {
          "type": "enum",
          "label": "Video quality (at most)",
          "options": [
            {
              "value": "best",
              "label": "Best available"
            },
            {
              "value": "1080",
              "label": "1080p"
            },
            {
              "value": "720",
              "label": "720p"
            },
            {
              "value": "480",
              "label": "480p"
            }
          ],
          "default": "1080"
        },
        "audioFormat": {
          "type": "enum",
          "label": "Audio format (audio only)",
          "options": [
            {
              "value": "m4a",
              "label": "M4A (AAC, usually no re-encoding)"
            },
            {
              "value": "mp3",
              "label": "MP3"
            },
            {
              "value": "opus",
              "label": "Opus"
            }
          ],
          "default": "m4a"
        },
        "playlist": {
          "type": "boolean",
          "label": "Download the whole playlist",
          "default": false
        },
        "subtitles": {
          "type": "boolean",
          "label": "Subtitles (English and Afrikaans, as SRT files)",
          "default": false
        },
        "sponsorblock": {
          "type": "boolean",
          "label": "Cut out sponsor segments (SponsorBlock)",
          "default": false
        }
      },
      "requires": [
        "yt-dlp",
        "deno",
        "ffmpeg"
      ]
    },
    {
      "id": "video.compress",
      "title": "Compress video",
      "description": "Smaller video files with presets for sharing, archiving and lectures, or a target size.",
      "category": "video",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".mp4",
          ".mkv",
          ".mov",
          ".webm",
          ".avi",
          ".m4v",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".ts",
          ".mts",
          ".m2ts",
          ".3gp"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "preset": {
          "type": "enum",
          "label": "Preset",
          "options": [
            {
              "value": "share",
              "label": "Share (small): up to 720p, H.264"
            },
            {
              "value": "balanced",
              "label": "Balanced: up to 1080p, H.264"
            },
            {
              "value": "archive",
              "label": "Archive: HEVC, smaller but slower (older devices may not play it)"
            },
            {
              "value": "lecture",
              "label": "Screen recording or lecture: 1080p, 15 fps, mono audio"
            },
            {
              "value": "target",
              "label": "Target size (enter MB below)"
            }
          ],
          "default": "balanced"
        },
        "targetMb": {
          "type": "number",
          "label": "Target size (for “Target size”)",
          "min": 1,
          "max": 100000,
          "default": 25,
          "step": 1,
          "unit": "MB"
        },
        "hardware": {
          "type": "boolean",
          "label": "Fast (hardware encoder, if this computer has one)",
          "default": false
        }
      },
      "requires": [
        "ffmpeg",
        "ffprobe"
      ]
    },
    {
      "id": "video.convert",
      "title": "Convert video",
      "description": "Change the container format. Streams are copied without quality loss whenever possible.",
      "category": "video",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".mp4",
          ".mkv",
          ".mov",
          ".webm",
          ".avi",
          ".m4v",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".ts",
          ".mts",
          ".m2ts",
          ".3gp"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "target": {
          "type": "enum",
          "label": "Convert to",
          "options": [
            {
              "value": "mp4",
              "label": "MP4"
            },
            {
              "value": "mkv",
              "label": "MKV"
            },
            {
              "value": "webm",
              "label": "WebM"
            },
            {
              "value": "mov",
              "label": "MOV"
            }
          ],
          "default": "mp4"
        }
      },
      "requires": [
        "ffmpeg",
        "ffprobe"
      ]
    },
    {
      "id": "audio.compress",
      "title": "Compress audio",
      "description": "Smaller audio files for speech, podcasts or music. Also extracts the sound from videos.",
      "category": "audio",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".mp3",
          ".m4a",
          ".aac",
          ".wav",
          ".flac",
          ".ogg",
          ".oga",
          ".opus",
          ".wma",
          ".aiff",
          ".aif",
          ".amr",
          ".mp4",
          ".mkv",
          ".mov",
          ".webm",
          ".avi",
          ".m4v",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".ts",
          ".mts",
          ".m2ts",
          ".3gp"
        ],
        "min": 1,
        "max": 100
      },
      "params": {
        "preset": {
          "type": "enum",
          "label": "Preset",
          "options": [
            {
              "value": "speech",
              "label": "Speech, smallest: Opus 32 kbps mono"
            },
            {
              "value": "speech-mp3",
              "label": "Speech, compatible: MP3 64 kbps mono"
            },
            {
              "value": "podcast",
              "label": "Podcast: MP3 96 kbps mono, loudness normalised"
            },
            {
              "value": "music",
              "label": "Music: AAC 192 kbps (M4A)"
            },
            {
              "value": "music-mp3",
              "label": "Music, compatible: MP3 VBR high quality"
            }
          ],
          "default": "speech"
        }
      },
      "requires": [
        "ffmpeg",
        "ffprobe"
      ]
    },
    {
      "id": "audio.convert",
      "title": "Convert audio",
      "description": "Change the audio format. The audio is copied without quality loss whenever possible.",
      "category": "audio",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".mp3",
          ".m4a",
          ".aac",
          ".wav",
          ".flac",
          ".ogg",
          ".oga",
          ".opus",
          ".wma",
          ".aiff",
          ".aif",
          ".amr",
          ".mp4",
          ".mkv",
          ".mov",
          ".webm",
          ".avi",
          ".m4v",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".ts",
          ".mts",
          ".m2ts",
          ".3gp"
        ],
        "min": 1,
        "max": 100
      },
      "params": {
        "target": {
          "type": "enum",
          "label": "Convert to",
          "options": [
            {
              "value": "mp3",
              "label": "MP3"
            },
            {
              "value": "m4a",
              "label": "M4A (AAC)"
            },
            {
              "value": "opus",
              "label": "Opus"
            },
            {
              "value": "ogg",
              "label": "OGG (Vorbis)"
            },
            {
              "value": "flac",
              "label": "FLAC (lossless)"
            },
            {
              "value": "wav",
              "label": "WAV (uncompressed)"
            }
          ],
          "default": "mp3"
        }
      },
      "requires": [
        "ffmpeg",
        "ffprobe"
      ]
    },
    {
      "id": "pdf.unlock",
      "title": "Unlock PDF",
      "description": "Removes printing/copying restrictions, or saves an unprotected copy of a PDF you know the password for. Removing restrictions from documents you do not own may breach the licence you received them under.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "password": {
          "type": "text",
          "label": "Open password (only if the PDF will not open without one)",
          "maxLength": 1024,
          "default": "",
          "secret": true
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "audio.transcribe",
      "title": "Transcribe (speech to text)",
      "description": "Turns speech in audio or video into text and subtitles with Whisper, entirely on this computer. Check names and technical terms: the transcript can contain mistakes.",
      "category": "audio",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".mp3",
          ".m4a",
          ".aac",
          ".wav",
          ".flac",
          ".ogg",
          ".oga",
          ".opus",
          ".wma",
          ".aiff",
          ".aif",
          ".amr",
          ".mp4",
          ".mkv",
          ".mov",
          ".webm",
          ".avi",
          ".m4v",
          ".wmv",
          ".flv",
          ".mpg",
          ".mpeg",
          ".ts",
          ".mts",
          ".m2ts",
          ".3gp"
        ],
        "min": 1,
        "max": 20
      },
      "params": {
        "model": {
          "type": "enum",
          "label": "Model",
          "options": [
            {
              "value": "turbo",
              "label": "Most accurate (large-v3-turbo), slower"
            },
            {
              "value": "small",
              "label": "Faster (small), less accurate, especially for Afrikaans"
            }
          ],
          "default": "turbo"
        },
        "language": {
          "type": "enum",
          "label": "Spoken language",
          "options": [
            {
              "value": "auto",
              "label": "Detect automatically"
            },
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "af",
              "label": "Afrikaans"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "es",
              "label": "Spanish"
            }
          ],
          "default": "auto"
        },
        "format": {
          "type": "enum",
          "label": "Output",
          "options": [
            {
              "value": "all",
              "label": "Text, SRT and VTT subtitles"
            },
            {
              "value": "txt",
              "label": "Text only (TXT)"
            },
            {
              "value": "srt",
              "label": "Subtitles (SRT)"
            },
            {
              "value": "vtt",
              "label": "Subtitles for the web (VTT)"
            }
          ],
          "default": "all"
        }
      },
      "requires": [
        "whisper",
        "ffmpeg",
        "ffprobe"
      ]
    },
    {
      "id": "pdf.merge",
      "title": "Merge PDFs",
      "description": "Combine PDFs into one, in the order you added them.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 2,
        "max": 200
      },
      "params": {
        "bookmarks": {
          "type": "boolean",
          "label": "Add a bookmark for each file",
          "default": true
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.split",
      "title": "Split PDF",
      "description": "Split into single pages, into parts of N pages, or by page ranges. The parts come in one ZIP file.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "mode": {
          "type": "enum",
          "label": "Split",
          "options": [
            {
              "value": "pages",
              "label": "Every page into its own PDF"
            },
            {
              "value": "chunks",
              "label": "Every N pages"
            },
            {
              "value": "ranges",
              "label": "By page ranges (one PDF per range)"
            }
          ],
          "default": "pages"
        },
        "chunk": {
          "type": "number",
          "label": "Pages per part (for \"every N pages\")",
          "min": 1,
          "max": 10000,
          "default": 10,
          "integer": true
        },
        "ranges": {
          "type": "text",
          "label": "Page ranges (for \"by page ranges\")",
          "maxLength": 500,
          "default": "",
          "placeholder": "e.g. 1-3, 4-10, 11-"
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.pages",
      "title": "Select, reorder or delete pages",
      "description": "Keep only some pages (in the order you type them) or delete pages.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "action": {
          "type": "enum",
          "label": "Action",
          "options": [
            {
              "value": "keep",
              "label": "Keep these pages, in this order"
            },
            {
              "value": "delete",
              "label": "Delete these pages"
            }
          ],
          "default": "keep"
        },
        "pages": {
          "type": "text",
          "label": "Pages",
          "maxLength": 500,
          "default": "",
          "placeholder": "e.g. 3, 1-2, 10-5"
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.rotate",
      "title": "Rotate pages",
      "description": "Turn all pages or selected pages.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "angle": {
          "type": "enum",
          "label": "Rotate",
          "options": [
            {
              "value": "90",
              "label": "90° clockwise"
            },
            {
              "value": "180",
              "label": "180°"
            },
            {
              "value": "270",
              "label": "90° anticlockwise"
            }
          ],
          "default": "90"
        },
        "pages": {
          "type": "text",
          "label": "Pages (empty = all pages)",
          "maxLength": 500,
          "default": "",
          "placeholder": "e.g. 1-3, 5, 8-"
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.compress",
      "title": "Compress PDF",
      "description": "Make PDFs smaller. Lossless only reorganises the file; the other levels also shrink and re-compress large photos.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "level": {
          "type": "enum",
          "label": "Level",
          "options": [
            {
              "value": "lossless",
              "label": "Lossless (no quality change, smaller gain)"
            },
            {
              "value": "balanced",
              "label": "Balanced: photos up to 2000 px, good quality"
            },
            {
              "value": "strong",
              "label": "Strong: photos up to 1200 px, for e-mail"
            }
          ],
          "default": "balanced"
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.protect",
      "title": "Protect PDF with a password",
      "description": "Encrypt with AES-256 so the PDF needs a password to open, and optionally restrict printing, copying and editing.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {
        "password": {
          "type": "text",
          "label": "Password to open the PDF",
          "maxLength": 256,
          "default": "",
          "secret": true
        },
        "allowPrint": {
          "type": "boolean",
          "label": "Allow printing",
          "default": true
        },
        "allowCopy": {
          "type": "boolean",
          "label": "Allow copying text and images",
          "default": false
        },
        "allowEdit": {
          "type": "boolean",
          "label": "Allow editing and form filling",
          "default": false
        }
      },
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.clean-metadata",
      "title": "Remove PDF metadata",
      "description": "Removes the author, title, software, dates and other hidden document information.",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
        "max": 50
      },
      "params": {},
      "requires": [
        "pikepdf"
      ]
    },
    {
      "id": "pdf.to-images",
      "title": "PDF to images",
      "description": "Save pages as PNG or JPG images (in a ZIP file when there is more than one page).",
      "category": "pdf",
      "runsIn": [
        "engine"
      ],
      "inputs": {
        "kinds": [
          "file"
        ],
        "accept": [
          ".pdf"
        ],
        "min": 1,
