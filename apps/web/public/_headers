# Cloudflare static asset response headers (Workers Static Assets and Pages both read this file).
# Cross-origin isolation (COOP/COEP) is deliberately NOT set: only add it if the
# multi-threaded ffmpeg.wasm build is adopted (DESIGN.md §8).
# The CSP matches the engine's (engine/werkbank_engine/security.py); phase 2 (WASM, CDN cores,
# optional engine connection) will need to extend both.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/version.json
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
